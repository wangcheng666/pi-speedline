{
  "name": "@qingwawangzi/pi-speedline",
  "version": "0.1.2",
  "description": "Unified pi speedometer: real-time calibrated tokens/s while streaming + exact per-turn TTFT and throughput in ONE theme-adaptive footer slot. Merges pi-tokens-per-second and pi-throughput-meter, timer-free.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/wangcheng666/pi-speedline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangcheng666/pi-speedline.git"
  },
  "bugs": {
    "url": "https://github.com/wangcheng666/pi-speedline/issues"
  },
  "keywords": [
    "pi-speedline",
    "speedline",
    "pi-package",
    "pi-extension",
    "tokens-per-second",
    "ttft",
    "throughput",
    "speedometer",
    "status-bar"
  ],
  "files": [
    "extensions",
    "dist/preview.png",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://cdn.jsdelivr.net/npm/@qingwawangzi/pi-speedline@0.1.0/dist/preview.png"
  },
